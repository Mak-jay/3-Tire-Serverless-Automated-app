            "id": "878429615",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"TerraformStateBucket\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:ListBucket\",\n        \"s3:GetObject\",\n        \"s3:DeleteObject\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::3tier-terraform-state-915370161738/*\",\n        \"arn:aws:s3:::3tier-terraform-state-915370161738\"\n      ]\n    },\n    {\n      \"Sid\": \"TerraformStateLock\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"dynamodb:PutItem\",\n        \"dynamodb:GetItem\",\n        \"dynamodb:DeleteItem\"\n      ],\n      \"Resource\": \"arn:aws:dynamodb:us-east-1:915370161738:table/3tier-terraform-locks\"\n    },\n    {\n      \"Sid\": \"AppS3\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:PutEncryptionConfiguration\",\n        \"s3:PutBucketWebsite\",\n        \"s3:PutBucketVersioning\",\n        \"s3:PutBucketTagging\",\n        \"s3:PutBucketPublicAccessBlock\",\n        \"s3:PutBucketPolicy\",\n        \"s3:PutBucketCORS\",\n        \"s3:ListBucket\",\n        \"s3:GetObject\",\n        \"s3:GetEncryptionConfiguration\",\n        \"s3:GetBucketWebsite\",\n        \"s3:GetBucketVersioning\",\n        \"s3:GetBucketTagging\",\n        \"s3:GetBucketPublicAccessBlock\",\n        \"s3:GetBucketPolicy\",\n        \"s3:GetBucketCORS\",\n        \"s3:DeleteObject\",\n        \"s3:DeleteBucketWebsite\",\n        \"s3:DeleteBucketPolicy\",\n        \"s3:DeleteBucket\",\n        \"s3:CreateBucket\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::3tier-*/*\",\n        \"arn:aws:s3:::3tier-*\"\n      ]\n    },\n    {\n      \"Sid\": \"AppDynamoDB\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"dynamodb:UpdateTimeToLive\",\n        \"dynamodb:UpdateTable\",\n        \"dynamodb:UpdateContinuousBackups\",\n        \"dynamodb:UntagResource\",\n        \"dynamodb:TagResource\",\n        \"dynamodb:ListTagsOfResource\",\n        \"dynamodb:DescribeTimeToLive\",\n        \"dynamodb:DescribeTable\",\n        \"dynamodb:DescribeContinuousBackups\",\n        \"dynamodb:DeleteTable\",\n        \"dynamodb:CreateTable\"\n      ],\n      \"Resource\": \"arn:aws:dynamodb:*:915370161738:table/3tier-*\"\n    },\n    {\n      \"Sid\": \"AppLambda\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"lambda:UpdateFunctionConfiguration\",\n        \"lambda:UpdateFunctionCode\",\n        \"lambda:UpdateAlias\",\n        \"lambda:UntagResource\",\n        \"lambda:TagResource\",\n        \"lambda:RemovePermission\",\n        \"lambda:PublishVersion\",\n        \"lambda:ListVersionsByFunction\",\n        \"lambda:ListTags\",\n        \"lambda:GetPolicy\",\n        \"lambda:GetFunctionConfiguration\",\n        \"lambda:GetFunction\",\n        \"lambda:GetAlias\",\n        \"lambda:DeleteFunction\",\n        \"lambda:DeleteAlias\",\n        \"lambda:CreateFunction\",\n        \"lambda:CreateAlias\",\n        \"lambda:AddPermission\"\n      ],\n      \"Resource\": \"arn:aws:lambda:*:915370161738:function:3tier-*\"\n    },\n    {\n      \"Sid\": \"AppApiGateway\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"apigateway:*\",\n      \"Resource\": \"arn:aws:apigateway:*::/restapis*\"\n    },\n    {\n      \"Sid\": \"AppCloudFront\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"cloudfront:UpdateDistribution\",\n        \"cloudfront:UntagResource\",\n        \"cloudfront:TagResource\",\n        \"cloudfront:ListDistributions\",\n        \"cloudfront:GetOriginAccessControl\",\n        \"cloudfront:GetInvalidation\",\n        \"cloudfront:GetDistribution\",\n        \"cloudfront:DeleteOriginAccessControl\",\n        \"cloudfront:DeleteDistribution\",\n        \"cloudfront:CreateOriginAccessControl\",\n        \"cloudfront:CreateInvalidation\",\n        \"cloudfront:CreateDistribution\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"AppLogs\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"logs:TagResource\",\n        \"logs:TagLogGroup\",\n        \"logs:PutRetentionPolicy\",\n        \"logs:DescribeLogGroups\",\n        \"logs:DeleteLogGroup\",\n        \"logs:CreateLogGroup\"\n      ],\n      \"Resource\": [\n        \"arn:aws:logs:*:915370161738:log-group:/aws/lambda/3tier-*:*\",\n        \"arn:aws:logs:*:915370161738:log-group:/aws/lambda/3tier-*\"\n      ]\n    },\n    {\n      \"Sid\": \"AppIAMRoles\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:UntagRole\",\n        \"iam:TagRole\",\n        \"iam:PutRolePolicy\",\n        \"iam:ListRolePolicies\",\n        \"iam:ListAttachedRolePolicies\",\n        \"iam:GetRolePolicy\",\n        \"iam:GetRole\",\n        \"iam:DetachRolePolicy\",\n        \"iam:DeleteRolePolicy\",\n        \"iam:DeleteRole\",\n        \"iam:CreateRole\",\n        \"iam:AttachRolePolicy\"\n      ],\n      \"Resource\": \"arn:aws:iam::915370161738:role/3tier-*\"\n    },\n    {\n      \"Sid\": \"AppIAMPassRole\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:PassRole\",\n      \"Resource\": \"arn:aws:iam::915370161738:role/3tier-*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"iam:PassedToService\": \"lambda.amazonaws.com\"\n        }\n      }\n    }\n  ]\n}",
