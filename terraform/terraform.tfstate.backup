                    "values": [
                      "repo:Mak-jay@98525743/3-Tire-Serverless-Automated-app@1333860190:ref:refs/heads/main"
                    ],
                    "variable": "token.actions.githubusercontent.com:sub"
                  }
                ],
                "effect": "Allow",
